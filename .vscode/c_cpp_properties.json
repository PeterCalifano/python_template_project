{
  "configurations": [
    {
      "name": "pybind11-extension",
      "browse": {
        "databaseFilename": "browse.vc.db",
        "limitSymbolsToIncludedHeaders": true
      },
      // Generated by the root CMakeLists.txt (CMAKE_EXPORT_COMPILE_COMMANDS ON)
      // once the extension has been built at least once with ./build_ext.sh.
      // It carries the real include paths for Python and pybind11, so the
      // includePath below is only a fallback for a not-yet-built tree.
      "compileCommands": "${workspaceFolder}/build/dev/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src/cpp/**"
      ],
      "intelliSenseMode": "linux-gcc-x64",
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
